state = { fails = 0 }

expect: i64 = (ok: bool, label: str)
    if ok
        print("ok: " .. label)
    else
        print("FAIL: " .. label)
        state.fails = state.fails + 1
    0

fixture: i64 = ()
    fc = wsp.agent.file(5, 3, 4, 4, 2, 6, 6, 3, 2, "choice")
    h = wsp.agent.seatfile(1, fc, "", 3, 2)
    wsp.agent.setvals(h, 5, 3, 4, 4, 2, 6, 6)
    fu = wsp.agent.file(0, 0, 0, 0, 0, 1, 6, 3, 2, "caution")
    h = wsp.agent.seatfile(2, fu, "", 3, 2)
    wsp.agent.setvals(h, 0, 0, 0, 0, 0, 1, 6)
    fs = wsp.agent.file(7, 7, 0, 0, 0, 0, 2, 2, 0, "spare")
    h = wsp.agent.seatfile(3, fs, "", 2, 0)
    wsp.agent.setvals(h, 7, 7, 0, 0, 0, 0, 2)
    1

swap: str = (text: str, from: str, into: str)
    out = ""
    i = 1
    while i <= text:len()
        if i + from:len() - 1 <= text:len() and text:sub(i, i + from:len() - 1) == from
            out = out .. into
            i = i + from:len()
        else
            out = out .. text:sub(i, i)
            i = i + 1
    out

main: i64 = ()
    expect(wsp.agent.init() == 1, "identity: the agent initialises")
    fixture()
    old = wsp.agent.current(1)
    oldid = wsp.agent.seatid(old)
    d = wsp.agent.sdigest(old)
    s1 = wsp.agent.step(1)
    o1 = wsp.agent.result(1)
    s2 = wsp.agent.step(2)
    prior = wsp.agent.store()
    expect(wsp.agent.citeof(s1, 1) == oldid, "identity: a row citation names its seating occurrence")
    expect(wsp.agent.standing(s2) == 1, "identity: the original transitive reader stands")
    expect(wsp.agent.withdraw(oldid) == 1, "identity: the original occurrence withdraws")
    expect(wsp.agent.standing(s1) == 0, "identity: withdrawal falls the direct reader")
    expect(wsp.agent.standing(o1) == 0, "identity: withdrawal falls the result")
    expect(wsp.agent.standing(s2) == 0, "identity: withdrawal falls the transitive reader")
    withdrawn = wsp.agent.store()
    expect(wsp.agent.load(prior) == -10, "identity: a saved active seating cannot clear withdrawal")
    expect(wsp.agent.refusal() == "seating withdrawal conflict", "identity: stale seating admission names the conflict")
    expect(wsp.agent.store() == withdrawn, "identity: stale seating refusal preserves the complete generation")
    expect(wsp.agent.seating(1) == old and wsp.agent.current(1) == old, "identity: stale seating refusal preserves both pointers")
    expect(wsp.agent.standing(s2) == 0, "identity: stale seating admission cannot revive the cone")

    fc = wsp.agent.file(5, 3, 4, 4, 2, 6, 6, 3, 2, "choice")
    fresh = wsp.agent.seatfile(1, fc, "", 3, 2)
    wsp.agent.setvals(fresh, 5, 3, 4, 4, 2, 6, 6)
    freshid = wsp.agent.seatid(fresh)
    expect(wsp.agent.sdigest(fresh) == d, "identity: the replacement has identical content")
    expect(freshid != oldid, "identity: identical content receives a fresh occurrence")
    sn = wsp.agent.step(1)
    on = wsp.agent.result(1)
    expect(wsp.agent.citeof(sn, 1) == freshid, "identity: the new reader cites the fresh occurrence")
    expect(wsp.agent.standing(sn) == 1, "identity: the fresh occurrence supports its reader")
    expect(wsp.agent.standing(on) == 1, "identity: the fresh occurrence supports its result")
    expect(wsp.agent.standing(s1) == 0, "identity: identical bytes cannot revive the withdrawn reader")
    expect(wsp.agent.standing(o1) == 0, "identity: identical bytes cannot revive the withdrawn result")
    expect(wsp.agent.standing(s2) == 0, "identity: identical bytes cannot revive the transitive reader")
    expect(wsp.agent.withdraw(d) == 0, "identity: an ambiguous content digest cannot choose an occurrence")
    expect(wsp.agent.withdraw(oldid) == 1, "identity: repeated withdrawal still names the old occurrence")
    expect(wsp.agent.standing(sn) == 1, "identity: withdrawing the old occurrence leaves the new one live")

    wsp.agent.activate(old)
    saved = wsp.agent.store()
    expect(wsp.agent.load(saved) == 1, "identity: the equal-content bundle reloads")
    expect(wsp.agent.seating(1) == old, "identity: reload preserves the exact active occurrence")
    expect(wsp.agent.current(1) == fresh, "identity: reload preserves the distinct current occurrence")
    expect(wsp.agent.standing(s1) == 0, "identity: reload preserves direct withdrawal")
    expect(wsp.agent.standing(s2) == 0, "identity: reload preserves transitive withdrawal")
    expect(wsp.agent.standing(sn) == 1, "identity: reload preserves the independent reader")
    expect(wsp.agent.standing(on) == 1, "identity: reload preserves the independent result")

    active = "A|1|" .. oldid .. "|" .. freshid
    ambiguous = swap(saved, active, "A|1|" .. d .. "|" .. d)
    expect(wsp.agent.load(ambiguous) == -10, "identity: ambiguous legacy active pointers refuse admission")
    expect(wsp.agent.seating(1) == old, "identity: refused pointers preserve the active occurrence")
    expect(wsp.agent.current(1) == fresh, "identity: refused pointers preserve the current occurrence")
    expect(wsp.agent.standing(sn) == 1, "identity: refused pointers preserve current evidence")
    absent = swap(saved, active, "A|1|" .. wsp.agent.seatid(999) .. "|" .. freshid)
    expect(wsp.agent.load(absent) == -10, "identity: missing active occurrences refuse admission")
    expect(wsp.agent.current(1) == fresh, "identity: missing pointers preserve current state")
    expect(wsp.agent.withdraw(freshid) == 1, "identity: the fresh occurrence withdraws independently")
    expect(wsp.agent.standing(sn) == 0, "identity: the fresh reader falls on its own withdrawal")
    expect(wsp.agent.standing(s1) == 0, "identity: the original withdrawal remains permanent")

    wsp.agent.reset()
    wsp.agent.init()
    fixture()
    h = wsp.agent.current(1)
    d = wsp.agent.sdigest(h)
    leaf = wsp.agent.begin(4, 0, 0, 0)
    wsp.agent.citeadd(leaf, d, 1, 0)
    wsp.agent.seal(leaf, "identity-1", compiler.digest.sha256("legacy leaf"))
    top = wsp.agent.begin(4, 0, 0, 0)
    wsp.agent.citeadd(top, wsp.agent.recid(leaf), 3, 0)
    wsp.agent.seal(top, "identity-1", compiler.digest.sha256("legacy top"))
    legacy = wsp.agent.store()
    legacy = swap(legacy, wsp.agent.seatid(h), d)
    legacy = swap(legacy, wsp.agent.seatid(wsp.agent.current(2)), wsp.agent.sdigest(wsp.agent.current(2)))
    legacy = swap(legacy, wsp.agent.seatid(wsp.agent.current(3)), wsp.agent.sdigest(wsp.agent.current(3)))
    expect(wsp.agent.load(legacy) == 1, "identity: an unambiguous legacy bundle remains readable")
    expect(wsp.agent.current(1) == h, "identity: an unambiguous legacy pointer resolves its occurrence")
    expect(wsp.agent.standing(top) == 1, "identity: legacy record hashes preserve transitive references")
    expect(wsp.agent.withdraw(d) == 1, "identity: an unambiguous legacy digest can withdraw")
    expect(wsp.agent.standing(top) == 0, "identity: a legacy withdrawal reaches the transitive reader")
    fresh = wsp.agent.seatfile(1, fc, "", 3, 2)
    wsp.agent.setvals(fresh, 5, 3, 4, 4, 2, 6, 6)
    expect(wsp.agent.standing(top) == -1, "identity: a legacy digest made ambiguous blocks validation")
    expect(wsp.agent.stands(top) == 0, "identity: ambiguous legacy evidence never resurrects")
    sn = wsp.agent.step(1)
    expect(wsp.agent.standing(sn) == 1, "identity: an occurrence citation survives legacy ambiguity")
    before = wsp.agent.store()
    nr = wsp.agent.nrecords()
    expect(wsp.agent.load(before) == -10, "identity: ambiguous legacy row citations refuse admission")
    expect(wsp.agent.nrecords() == nr, "identity: refused legacy citations preserve records")
    expect(wsp.agent.current(1) == fresh, "identity: refused legacy citations preserve current identity")
    expect(wsp.agent.standing(sn) == 1, "identity: refused legacy citations preserve live readers")

    wsp.agent.reset()
    wsp.agent.init()
    fixture()
    old = wsp.agent.current(1)
    d = wsp.agent.sdigest(old)
    s1 = wsp.agent.step(1)
    o1 = wsp.agent.result(1)
    keeper = wsp.agent.step(3)
    p = wsp.agent.fact(1)
    q = wsp.agent.fact(4)
    prior = wsp.agent.store()
    expect(wsp.agent.withdraw(p) == 1, "identity: the premise occurrence withdraws")
    withdrawn = wsp.agent.store()
    expect(wsp.agent.load(prior) == -10, "identity: a saved active premise cannot clear withdrawal")
    expect(wsp.agent.refusal() == "premise withdrawal conflict", "identity: stale premise admission names the conflict")
    expect(wsp.agent.store() == withdrawn, "identity: stale premise refusal preserves the complete generation")
    expect(wsp.agent.seating(1) == old and wsp.agent.current(1) == old, "identity: stale premise refusal preserves both pointers")
    expect(wsp.agent.premstate(p) == 0 and wsp.agent.standing(s1) == 0, "identity: stale premise admission preserves withdrawal and its cone")
    expect(wsp.agent.standing(keeper) == 1, "identity: stale premise refusal preserves independent evidence")

    expect(wsp.agent.withdraw(q) == 1, "identity: the last premise occurrence withdraws")
    withdrawn = wsp.agent.store()
    b = 10
    qline = "P|" .. compiler.digest.sha256("the read of f returned the expected digest") .. "|2|1" .. b:char()
    truncated = swap(withdrawn, qline, "")
    expect(wsp.agent.load(truncated) == -10, "identity: dropping a withdrawn occurrence refuses admission")
    expect(wsp.agent.refusal() == "identity inventory truncated", "identity: dropped occurrence admission names the missing inventory")
    expect(wsp.agent.store() == withdrawn, "identity: a dropped occurrence cannot clear the current generation")
    expect(wsp.agent.premstate(q) == 0, "identity: a dropped occurrence cannot erase permanent withdrawal")
    expect(wsp.agent.seating(1) == old and wsp.agent.current(1) == old, "identity: truncated admission preserves both pointers")
    expect(wsp.agent.standing(keeper) == 1, "identity: truncated admission preserves independent evidence")

    pc = compiler.digest.sha256("the target file is f")
    pd = compiler.digest.sha256("a different premise statement")
    conflict = swap(withdrawn, "P|" .. pc .. "|", "P|" .. pd .. "|")
    expect(wsp.agent.load(conflict) == -10, "identity: changing a known premise occurrence body refuses")
    expect(wsp.agent.refusal() == "premise identity conflict", "identity: conflicting premise admission names the conflict")
    expect(wsp.agent.store() == withdrawn, "identity: conflicting premise admission preserves the complete generation")
    expect(wsp.agent.premstate(p) == 0 and wsp.agent.standing(keeper) == 1, "identity: conflicting premise admission preserves both evidence states")

    changed = wsp.agent.file(6, 3, 4, 4, 2, 6, 6, 3, 2, "choice")
    fresh = wsp.agent.seatfile(1, changed, "", 3, 2)
    wsp.agent.setvals(fresh, 6, 3, 4, 4, 2, 6, 6)
    freshd = wsp.agent.sdigest(fresh)
    keeper = wsp.agent.step(3)
    saved = wsp.agent.store()
    conflict = swap(saved, "S|1|" .. d .. "|", "S|1|" .. freshd .. "|")
    conflict = swap(conflict, "|5,3,4,4,2,6", "|6,3,4,4,2,6")
    expect(wsp.agent.load(conflict) == -10, "identity: changing a known seating occurrence body refuses")
    expect(wsp.agent.refusal() == "seating identity conflict", "identity: conflicting seating admission names the conflict")
    expect(wsp.agent.store() == saved, "identity: conflicting seating admission preserves the complete generation")
    expect(wsp.agent.seating(1) == fresh and wsp.agent.current(1) == fresh, "identity: conflicting seating admission preserves both pointers")
    expect(wsp.agent.standing(keeper) == 1, "identity: conflicting seating admission preserves live evidence")

    corrupt = swap(saved, "|6,3,4,4,2,6", "|9,3,4,4,2,6")
    expect(wsp.agent.load(corrupt) == -9, "identity: a later seating payload with a false digest refuses")
    expect(wsp.agent.refusal() == "readback digest", "identity: corrupted seating admission names the digest failure")
    expect(wsp.agent.store() == saved, "identity: failed payload validation preserves the complete generation")
    expect(wsp.agent.seating(1) == fresh and wsp.agent.current(1) == fresh, "identity: failed payload validation preserves both pointers")
    expect(wsp.agent.standing(keeper) == 1 and wsp.agent.standing(s1) == 0, "identity: failed payload validation preserves live and withdrawn evidence")

    malformed = swap(saved, "|3|2|6,3,4,4,2,6", "|4|2|6,3,4,4,2,6")
    expect(wsp.agent.load(malformed) == -1, "identity: malformed seating admission refuses before commit")
    expect(wsp.agent.store() == saved, "identity: failed seating admission preserves the complete generation")
    expect(wsp.agent.seating(1) == fresh and wsp.agent.current(1) == fresh, "identity: failed seating admission preserves both pointers")
    expect(wsp.agent.standing(keeper) == 1, "identity: failed seating admission preserves live evidence")

    expanded = swap(saved, "|6,3,4,4,2,6", "|6,3,4,4,2,6,8,9")
    expect(wsp.agent.load(expanded) == -1, "identity: excess CSV values refuse admission")
    expect(wsp.agent.refusal() == "seating cardinality", "identity: excess values cannot hide behind a shorter resident span")
    expect(wsp.agent.store() == saved, "identity: excess value refusal preserves the complete generation")
    expect(wsp.agent.seating(1) == fresh and wsp.agent.current(1) == fresh, "identity: excess value refusal preserves both pointers")
    expect(wsp.agent.standing(keeper) == 1, "identity: excess value refusal preserves live evidence")

    liveprem = wsp.agent.fact(2)
    malformedprem = liveprem:sub(1, 62) .. "2x"
    expect(wsp.agent.premstate(malformedprem) == -1, "identity: a malformed premise suffix is unresolved")
    expect(wsp.agent.withdraw(malformedprem) == 0, "identity: a malformed premise alias cannot withdraw")
    expect(wsp.agent.premstate(liveprem) == 1, "identity: rejecting a malformed alias preserves the legitimate premise")
    expect(wsp.agent.standing(keeper) == 1, "identity: rejecting a malformed alias preserves its reader")

    wsp.agent.reset()
    wsp.agent.init()
    fixture()
    csv = "5,3,4,4,2,6,8,9"
    widefile = wsp.agent.filecsv(csv, 8, 4, 2, "choice")
    wide = wsp.agent.seatfile(1, widefile, "", 4, 2)
    wsp.agent.setcsv(wide, csv, 8)
    keeper = wsp.agent.step(3)
    wd = wsp.agent.sdigest(wide)
    saved = wsp.agent.store()
    expect(wsp.agent.load(saved) == 1, "identity: an eight-value seating bundle reloads")
    expect(wsp.agent.seating(1) == wide and wsp.agent.current(1) == wide, "identity: extended reload preserves both occurrence pointers")
    expect(wsp.agent.sdigest(wide) == wd, "identity: extended reload preserves the complete digest")
    expect(wsp.agent.params() == 16, "identity: extended reload retains all eight choice values")
    expect(wsp.agent.store() == saved, "identity: extended reload preserves the complete bundle")
    expect(wsp.agent.standing(keeper) == 1, "identity: extended reload preserves a live reader")

    if state.fails > 0
        print("identity: FAIL")
        return 1
    print("identity: OK")
    0

os.exit(main())
