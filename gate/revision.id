# The WS-CONF-4 battery: the weights chapter's revision
# query faces, whole-support learn validation, and the
# relearning and transaction protocols against conformance
# examples E18, E21, E22, E23, E24, E25, E28 and E29
# (spec-revision-faces.md section 6). Every check prints
# one line; the closing vector is the verdict. Run by
# gate/revision.sh.

bc = {}

chk: i64 = (label: str, cond: bool)
    if cond
        bc.ok = bc.ok + 1
        print("ok: " .. label)
        return 1
    bc.bad = bc.bad + 1
    print("FAIL: " .. label)
    0

streq: i64 = (a: str, b: str)
    if a:len() != b:len()
        return 0
    i = 1
    while i <= a:len()
        if a:byte(i) != b:byte(i)
            return 0
        i = i + 1
    1

digits: str = (v: i64)
    if v == 0
        return "0"
    out = ""
    n = v
    while n > 0
        out = "0123456789":sub(n % 10 + 1, n % 10 + 1) .. out
        n = n // 10
    out

itext: str = (v: i64)
    if v < 0
        return "-" .. digits(0 - v)
    digits(v)

appv: str = (a: str, v: str)
    a .. v

evtext2: str = (a: i64, b: i64)
    appv(appv(itext(a), ","), itext(b))

evtext3: str = (a: i64, b: i64, c: i64)
    appv(appv(evtext2(a, b), ","), itext(c))

eqrat: i64 = (w: i64, i: i64, n: i64, d: i64)
    r = wsp.numeric.at(w, i)
    if r < 0
        return 0
    q = wsp.numeric.rat(n, d)
    wsp.numeric.req(r, q)

main: i64 = ()
    bc.ok = 0
    bc.bad = 0
    wsp.agent.init()

    anc = wsp.numeric.lit(0, 0, "", "0")
    dw = wsp.numeric.lit(0, 0, "", "1")
    p15 = wsp.numeric.premiseover("wsconf4 e15 premise p", dw)
    e15 = wsp.numeric.event(anc, dw, p15)
    r15 = wsp.numeric.revision(anc, itext(e15), "")
    rd15 = wsp.numeric.revision(anc, evtext3(e15, e15, e15), "")
    chk("e15 repeated reference constructs", rd15 >= 1)
    chk("e15 repeated reference has one member", wsp.numeric.members(rd15) == 1)
    chk("e15 repeated reference has one live member", wsp.numeric.livecount(rd15) == 1)
    chk("e15 repeated reference preserves membership equivalence", wsp.numeric.equivalent(r15, rd15) == 1)
    chk("e15 repeated reference contributes once", eqrat(wsp.numeric.observe(rd15), 0, 1, 1) == 1)
    e15b = wsp.numeric.event(anc, dw, p15)
    chk("e15 equal payload event is a distinct occurrence", e15b != e15)
    rp15 = wsp.numeric.revision(anc, evtext3(e15, e15b, e15), "")
    rr15 = wsp.numeric.revision(anc, evtext2(e15b, e15), "")
    chk("e15 distinct equal events both remain members", wsp.numeric.members(rp15) == 2)
    chk("e15 distinct equal events both remain live", wsp.numeric.livecount(rp15) == 2)
    chk("e15 distinct equal events each contribute once", eqrat(wsp.numeric.total(rp15), 0, 2, 1) == 1)
    chk("e15 order preserves membership equivalence", wsp.numeric.equivalent(rp15, rr15) == 1)
    chk("e15 order preserves observation", eqrat(wsp.numeric.observe(rr15), 0, 2, 1) == 1)
    chk("e15 shared premise withdrawal commits", wsp.agent.withdraw(p15) == 1)
    chk("e15 shared event excluded once", wsp.numeric.livecount(rd15) == 0)
    chk("e15 both equal occurrences excluded", wsp.numeric.livecount(rp15) == 0)
    chk("e15 withdrawal preserves the one event inventory", wsp.numeric.members(rd15) == 1)
    chk("e15 withdrawal preserves the two event inventory", wsp.numeric.members(rp15) == 2)
    chk("e15 withdrawn duplicate recipe observes the anchor", eqrat(wsp.numeric.observe(rd15), 0, 0, 1) == 1)
    chk("e15 first occurrence exclusion justified", wsp.numeric.excluded(rp15, e15) == 1)
    chk("e15 second occurrence exclusion justified", wsp.numeric.excluded(rp15, e15b) == 1)
    history = wsp.numeric.revision(anc, evtext3(e15, e15b, e15), "")
    chk("e15 withdrawn candidates remain valid historical references", history >= 1)
    chk("e15 historical inventory keeps distinct occurrences", wsp.numeric.members(history) == 2)
    chk("e15 retaining withdrawn candidates does not demand their evidence", eqrat(wsp.numeric.observe(history), 0, 0, 1) == 1)

    # E18: relearning after correction (chapter 5.4,
    # spec section 5.1)
    anc = wsp.numeric.lit(0, 0, "2", "10,20")
    dpw = wsp.numeric.lit(0, 0, "2", "1,0")
    dqw = wsp.numeric.lit(0, 0, "2", "0,2")
    p = wsp.numeric.premiseover("wsconf4 e18 premise p", dpw)
    q = wsp.numeric.premiseover("wsconf4 e18 premise q", dqw)
    chk("e18 premise p live", wsp.agent.premstate(p) == 1)
    chk("e18 premise q live", wsp.agent.premstate(q) == 1)
    ep = wsp.numeric.event(anc, dpw, p)
    eq = wsp.numeric.event(anc, dqw, q)
    chk("e18 event p constructs", ep >= 1)
    chk("e18 event q constructs", eq >= 1)
    rev = wsp.numeric.revision(anc, evtext2(ep, eq), "")
    chk("e18 revision constructs", rev >= 1)
    ob = wsp.numeric.observe(rev)
    chk("e18 observation constructs", ob >= 1)
    chk("e18 revision observes 11", eqrat(ob, 0, 11, 1) == 1)
    chk("e18 revision observes 22", eqrat(ob, 1, 22, 1) == 1)
    chk("e18 withdrawal lands", wsp.agent.withdraw(p) == 1)
    chk("e18 live set after withdrawal", wsp.numeric.livecount(rev) == 1)
    ob2 = wsp.numeric.observe(rev)
    chk("e18 observation after withdrawal 10", eqrat(ob2, 0, 10, 1) == 1)
    chk("e18 observation after withdrawal 22", eqrat(ob2, 1, 22, 1) == 1)
    dpc = wsp.numeric.lit(0, 0, "2", "3,0")
    pc = wsp.numeric.premiseover("wsconf4 e18 premise p corrected", dpc)
    chk("e18 corrected premise is a fresh identity", streq(pc, p) == 0)
    chk("e18 corrected premise live", wsp.agent.premstate(pc) == 1)
    chk("e18 correction does not reactivate the old premise", wsp.agent.premstate(p) == 0)
    epc = wsp.numeric.event(anc, dpc, pc)
    chk("e18 relearned event constructs", epc >= 1)
    rev2 = wsp.numeric.revision(anc, evtext3(ep, eq, epc), "")
    chk("e18 mixed revision constructs", rev2 >= 1)
    chk("e18 mixed inventory holds all three events", wsp.numeric.members(rev2) == 3)
    chk("e18 mixed live set excludes the old event", wsp.numeric.livecount(rev2) == 2)
    ob3 = wsp.numeric.observe(rev2)
    chk("e18 mixed revision observes 13", eqrat(ob3, 0, 13, 1) == 1)
    chk("e18 mixed revision observes 22", eqrat(ob3, 1, 22, 1) == 1)
    chk("e18 learning under the withdrawn premise refuses", wsp.numeric.event(anc, dpc, p) == -17)
    chk("e18 refusal named withdrawn", streq(wsp.numeric.refusal(), "withdrawn") == 1)

    # E21: equal snapshots, different revisions
    # (chapter 5.3, 7; spec section 4)
    anc = wsp.numeric.lit(3, 0, "1", "16777216")
    d1 = wsp.numeric.lit(0, 0, "1", "1")
    p21 = wsp.numeric.premiseover("wsconf4 e21 premise p", d1)
    e1 = wsp.numeric.event(anc, d1, p21)
    chk("e21 event constructs", e1 >= 1)
    r0 = wsp.numeric.revision(anc, "", "")
    r1 = wsp.numeric.revision(anc, itext(e1), "")
    chk("e21 empty revision constructs", r0 >= 1)
    chk("e21 one event revision constructs", r1 >= 1)
    chk("e21 empty inventory", wsp.numeric.members(r0) == 0)
    chk("e21 single inventory", wsp.numeric.members(r1) == 1)
    chk("e21 revisions are not equivalent", wsp.numeric.equivalent(r0, r1) == 0)
    chk("e21 revision equivalent to itself", wsp.numeric.equivalent(r1, r1) == 1)
    r1b = wsp.numeric.revision(anc, itext(e1), "")
    chk("e21 rebuilt revision is a distinct handle", r1b != r1)
    chk("e21 rebuilt revision is equivalent", wsp.numeric.equivalent(r1, r1b) == 1)
    s0 = wsp.numeric.observe(r0)
    s1 = wsp.numeric.observe(r1)
    chk("e21 empty snapshot constructs", s0 >= 1)
    chk("e21 one event snapshot constructs", s1 >= 1)
    chk("e21 snapshot of empty revision", eqrat(s0, 0, 16777216, 1) == 1)
    chk("e21 snapshot of one event revision", eqrat(s1, 0, 16777216, 1) == 1)
    chk("e21 snapshots numerically equal", wsp.numeric.numeric(s0, s1) == 1)
    chk("e21 snapshot digests equal", streq(wsp.numeric.digestof(s0), wsp.numeric.digestof(s1)) == 1)
    t0 = wsp.numeric.total(r0)
    t1 = wsp.numeric.total(r1)
    chk("e21 totals construct", t0 >= 1)
    chk("e21 exact total of empty revision", eqrat(t0, 0, 16777216, 1) == 1)
    chk("e21 exact total of one event revision", eqrat(t1, 0, 16777217, 1) == 1)
    chk("e21 exact totals differ", wsp.numeric.numeric(t0, t1) == 0)
    e2 = wsp.numeric.event(anc, d1, p21)
    e3 = wsp.numeric.event(anc, d1, p21)
    chk("e21 second event constructs", e2 >= 1)
    chk("e21 third event constructs", e3 >= 1)
    chk("e21 second events are distinct occurrences", e2 != e3)
    r0x = wsp.numeric.revision(anc, itext(e2), "")
    r1x = wsp.numeric.revision(anc, evtext2(e1, e3), "")
    s0x = wsp.numeric.observe(r0x)
    s1x = wsp.numeric.observe(r1x)
    chk("e21 extended empty revision observes the anchor", eqrat(s0x, 0, 16777216, 1) == 1)
    chk("e21 extended one event revision observes two more", eqrat(s1x, 0, 16777218, 1) == 1)
    chk("e21 extended snapshots differ", wsp.numeric.numeric(s0x, s1x) == 0)

    # E22: withdrawal can expose overflow (chapter 5.4)
    anc = wsp.numeric.lit(1, 8, "1", "100")
    dneg = wsp.numeric.lit(0, 0, "1", "-100")
    dpos = wsp.numeric.lit(0, 0, "1", "100")
    p = wsp.numeric.premiseover("wsconf4 e22 premise p", dneg)
    q = wsp.numeric.premiseover("wsconf4 e22 premise q", dpos)
    ep = wsp.numeric.event(anc, dneg, p)
    eq = wsp.numeric.event(anc, dpos, q)
    chk("e22 event p constructs", ep >= 1)
    chk("e22 event q constructs", eq >= 1)
    rev = wsp.numeric.revision(anc, evtext2(ep, eq), "")
    ob = wsp.numeric.observe(rev)
    chk("e22 observation constructs", ob >= 1)
    chk("e22 both live observe 100", eqrat(ob, 0, 100, 1) == 1)
    chk("e22 withdrawal lands", wsp.agent.withdraw(p) == 1)
    chk("e22 surviving live count", wsp.numeric.livecount(rev) == 1)
    tw = wsp.numeric.total(rev)
    chk("e22 surviving total constructs", tw >= 1)
    chk("e22 surviving total is exactly 200", eqrat(tw, 0, 200, 1) == 1)
    chk("e22 observe refuses range", wsp.numeric.observe(rev) == -3)
    chk("e22 refusal named range", streq(wsp.numeric.refusal(), "range") == 1)

    # E23: rational delta can exceed target range
    # (chapter 5.1, 5.3)
    anc = wsp.numeric.lit(1, 8, "1", "127")
    dbig = wsp.numeric.lit(0, 0, "1", "-255")
    rp = wsp.numeric.premiseover("wsconf4 e23 premise r", dbig)
    ev = wsp.numeric.event(anc, dbig, rp)
    chk("e23 oversize delta event constructs", ev >= 1)
    rev = wsp.numeric.revision(anc, itext(ev), "")
    tw = wsp.numeric.total(rev)
    chk("e23 total constructs", tw >= 1)
    chk("e23 exact total is minus 128", eqrat(tw, 0, -128, 1) == 1)
    ob = wsp.numeric.observe(rev)
    chk("e23 observation constructs", ob >= 1)
    chk("e23 observed value is minus 128", eqrat(ob, 0, -128, 1) == 1)
    chk("e23 the delta alone refuses range", wsp.numeric.cast(1, 8, dbig) == -3)
    chk("e23 refusal named range", streq(wsp.numeric.refusal(), "range") == 1)

    # E24: pure numeric replacement preserves support
    # (chapter 2.2, 5.2; spec section 2)
    anc = wsp.numeric.lit(0, 0, "2", "10,20")
    dpw = wsp.numeric.lit(0, 0, "2", "1,0")
    dqw = wsp.numeric.lit(0, 0, "2", "0,2")
    p = wsp.numeric.premiseover("wsconf4 e24 premise p", dpw)
    q = wsp.numeric.premiseover("wsconf4 e24 premise q", dqw)
    ep = wsp.numeric.event(anc, dpw, p)
    eq = wsp.numeric.event(anc, dqw, q)
    rev = wsp.numeric.revision(anc, evtext2(ep, eq), "")
    snap = wsp.numeric.observe(rev)
    chk("e24 snapshot constructs", snap >= 1)
    chk("e24 snapshot observes 11", eqrat(snap, 0, 11, 1) == 1)
    chk("e24 snapshot observes 22", eqrat(snap, 1, 22, 1) == 1)
    chk("e24 snapshot carries both premises", wsp.numeric.supportcount(snap) == 2)
    x = wsp.numeric.read(snap, "0")
    chk("e24 read constructs", x >= 1)
    chk("e24 extracted scalar is 11", eqrat(x, 0, 11, 1) == 1)
    chk("e24 extracted scalar is rank zero", wsp.numeric.rankof(x) == 0)
    chk("e24 extracted scalar keeps support", wsp.numeric.supportcount(x) == 2)
    zero = wsp.numeric.lit(0, 0, "", "0")
    z = wsp.numeric.mul(x, zero)
    chk("e24 zero product is zero", eqrat(z, 0, 0, 1) == 1)
    chk("e24 zero product keeps both premises", wsp.numeric.supportcount(z) == 2)
    chk("e24 zero product support has p", wsp.numeric.supporthas(z, p) == 1)
    chk("e24 zero product support has q", wsp.numeric.supporthas(z, q) == 1)
    chk("e24 zero product usable", wsp.numeric.usable(z) == 1)
    chk("e24 withdrawal lands", wsp.agent.withdraw(p) == 1)
    chk("e24 historical payload still reads zero", eqrat(z, 0, 0, 1) == 1)
    chk("e24 support retained after withdrawal", wsp.numeric.supporthas(z, p) == 1)
    chk("e24 zero product no longer usable", wsp.numeric.usable(z) == 0)
    anc2 = wsp.numeric.lit(0, 0, "", "100")
    rr = wsp.numeric.premiseover("wsconf4 e24 premise r", anc2)
    chk("e24 learning from the cancelled scalar refuses", wsp.numeric.event(anc2, z, rr) == -17)
    chk("e24 refusal named withdrawn", streq(wsp.numeric.refusal(), "withdrawn") == 1)
    chk("e24 clean zero delta learns", wsp.numeric.event(anc2, zero, rr) >= 1)

    # E25: opaque dependent base (chapter 5.4)
    anc = wsp.numeric.lit(0, 0, "2", "10,20")
    dpw = wsp.numeric.lit(0, 0, "2", "1,0")
    dqw = wsp.numeric.lit(0, 0, "2", "0,2")
    p = wsp.numeric.premiseover("wsconf4 e25 premise p", dpw)
    q = wsp.numeric.premiseover("wsconf4 e25 premise q", dqw)
    ep = wsp.numeric.event(anc, dpw, p)
    eq = wsp.numeric.event(anc, dqw, q)
    rev = wsp.numeric.revision(anc, evtext2(ep, eq), "")
    snap = wsp.numeric.observe(rev)
    chk("e25 snapshot constructs", snap >= 1)
    chk("e25 snapshot observes 11", eqrat(snap, 0, 11, 1) == 1)
    chk("e25 snapshot observes 22", eqrat(snap, 1, 22, 1) == 1)
    zeros = wsp.numeric.lit(0, 0, "2", "0,0")
    copied = wsp.numeric.add(snap, zeros)
    chk("e25 copy is a new handle", wsp.numeric.same(snap, copied) == 0)
    chk("e25 copy is numerically equal", wsp.numeric.numeric(snap, copied) == 1)
    chk("e25 copy retains both premises", wsp.numeric.supportcount(copied) == 2)
    chk("e25 copy support has p", wsp.numeric.supporthas(copied, p) == 1)
    chk("e25 copy support has q", wsp.numeric.supporthas(copied, q) == 1)
    revc = wsp.numeric.revision(copied, "", "")
    obc = wsp.numeric.observe(revc)
    chk("e25 rooted observation constructs", obc >= 1)
    chk("e25 rooted revision observes 11", eqrat(obc, 0, 11, 1) == 1)
    chk("e25 rooted revision observes 22", eqrat(obc, 1, 22, 1) == 1)
    chk("e25 withdrawal lands", wsp.agent.withdraw(p) == 1)
    chk("e25 observing the copied root refuses anchor", wsp.numeric.observe(revc) == -13)
    chk("e25 refusal named anchor", streq(wsp.numeric.refusal(), "anchor") == 1)
    chk("e25 total of the copied root refuses anchor", wsp.numeric.total(revc) == -13)
    ob4 = wsp.numeric.observe(rev)
    chk("e25 source revision still observes 10", eqrat(ob4, 0, 10, 1) == 1)
    chk("e25 source revision still observes 22", eqrat(ob4, 1, 22, 1) == 1)

    # E28: fixed-scope absence (chapter 5.3; spec
    # section 3)
    anc = wsp.numeric.lit(0, 0, "1", "5")
    dpw = wsp.numeric.lit(0, 0, "1", "7")
    p = wsp.numeric.premiseover("wsconf4 e28 premise p", dpw)
    ep = wsp.numeric.event(anc, dpw, p)
    rev = wsp.numeric.revision(anc, itext(ep), "")
    chk("e28 inventory fixed at one", wsp.numeric.members(rev) == 1)
    chk("e28 event live before withdrawal", wsp.numeric.livecount(rev) == 1)
    chk("e28 live event is not excluded", wsp.numeric.excluded(rev, ep) == 0)
    chk("e28 live event has no receipt", streq(wsp.numeric.receipt(rev, ep), "") == 1)
    chk("e28 withdrawal lands", wsp.agent.withdraw(p) == 1)
    chk("e28 inventory unchanged by withdrawal", wsp.numeric.members(rev) == 1)
    chk("e28 query live set empty", wsp.numeric.livecount(rev) == 0)
    chk("e28 event excluded after withdrawal", wsp.numeric.excluded(rev, ep) == 1)
    chk("e28 receipt names the withdrawn premise", streq(wsp.numeric.receipt(rev, ep), wsp.agent.premiseid(p)) == 1)
    chk("e28 withdrawal receipt is permanent", wsp.agent.premstate(p) == 0)
    dqw = wsp.numeric.lit(0, 0, "1", "3")
    q = wsp.numeric.premiseover("wsconf4 e28 premise q", dqw)
    eq = wsp.numeric.event(anc, dqw, q)
    chk("e28 later event constructs", eq >= 1)
    chk("e28 old inventory unchanged by later event", wsp.numeric.members(rev) == 1)
    chk("e28 old query still empty", wsp.numeric.livecount(rev) == 0)
    chk("e28 non member refuses contract", wsp.numeric.excluded(rev, eq) == -11)
    chk("e28 refusal named contract", streq(wsp.numeric.refusal(), "contract") == 1)
    rev2 = wsp.numeric.revision(anc, evtext2(ep, eq), "")
    chk("e28 new inventory holds both", wsp.numeric.members(rev2) == 2)
    chk("e28 new revision sees the later event", wsp.numeric.livecount(rev2) == 1)
    ghost = compiler.digest.sha256("wsconf4 e28 untracked absence")
    chk("e28 untracked absence is unresolved", wsp.agent.premstate(ghost) == -1)
    chk("e28 learning from untracked absence refuses", wsp.numeric.event(anc, dqw, ghost) == -12)
    chk("e28 refusal named unknown", streq(wsp.numeric.refusal(), "unknown") == 1)

    # E29: concurrency (chapter 5.6; spec section 5.2)
    anc = wsp.numeric.lit(0, 0, "1", "0")
    dw = wsp.numeric.lit(0, 0, "1", "4")
    p = wsp.numeric.premiseover("wsconf4 e29 premise p", dw)
    ea = wsp.numeric.event(anc, dw, p)
    chk("e29 commit first event constructs", ea >= 1)
    reva = wsp.numeric.revision(anc, itext(ea), "")
    chk("e29 committed event live", wsp.numeric.livecount(reva) == 1)
    oba = wsp.numeric.observe(reva)
    chk("e29 committed revision observes 4", eqrat(oba, 0, 4, 1) == 1)
    chk("e29 retraction lands after commit", wsp.agent.withdraw(p) == 1)
    chk("e29 retraction excludes the committed event", wsp.numeric.livecount(reva) == 0)
    obb = wsp.numeric.observe(reva)
    chk("e29 observation after retraction is the anchor alone", eqrat(obb, 0, 0, 1) == 1)
    p2 = wsp.numeric.premiseover("wsconf4 e29 premise p two", dw)
    chk("e29 second premise live", wsp.agent.premstate(p2) == 1)
    chk("e29 withdrawal commits first", wsp.agent.withdraw(p2) == 1)
    chk("e29 learning after withdrawal refuses", wsp.numeric.event(anc, dw, p2) == -17)
    chk("e29 refusal named withdrawn", streq(wsp.numeric.refusal(), "withdrawn") == 1)
    p3 = wsp.numeric.premiseover("wsconf4 e29 premise p three", dw)
    e3 = wsp.numeric.event(anc, dw, p3)
    chk("e29 pinned event constructs", e3 >= 1)
    rev3 = wsp.numeric.revision(anc, itext(e3), "")
    snap3 = wsp.numeric.observe(rev3)
    chk("e29 pinned snapshot constructs", snap3 >= 1)
    chk("e29 pinned snapshot carries the third premise", wsp.numeric.supportcount(snap3) == 1)
    chk("e29 pinned snapshot support has p3", wsp.numeric.supporthas(snap3, p3) == 1)
    dfrom = wsp.numeric.sub(snap3, anc)
    chk("e29 computed delta constructs", dfrom >= 1)
    chk("e29 computed delta value is 4", eqrat(dfrom, 0, 4, 1) == 1)
    chk("e29 computed delta carries p3", wsp.numeric.supporthas(dfrom, p3) == 1)
    chk("e29 third premise live at computation", wsp.agent.premstate(p3) == 1)
    chk("e29 third withdrawal lands", wsp.agent.withdraw(p3) == 1)
    rr = wsp.numeric.premiseover("wsconf4 e29 premise r", anc)
    chk("e29 commit of the computed delta refuses", wsp.numeric.event(anc, dfrom, rr) == -17)
    chk("e29 refusal named withdrawn again", streq(wsp.numeric.refusal(), "withdrawn") == 1)
    chk("e29 pinned revision has no live dependent event", wsp.numeric.livecount(rev3) == 0)
    chk("e29 first revision still has no live dependent event", wsp.numeric.livecount(reva) == 0)

    anc31 = wsp.numeric.lit(0, 0, "1", "0")
    dw31 = wsp.numeric.lit(0, 0, "1", "2")
    p31 = wsp.numeric.premiseover("wsconf4 e31 selection premise p", anc31)
    q31 = wsp.numeric.premiseover("wsconf4 e31 event premise q", dw31)
    e31 = wsp.numeric.event(anc31, dw31, q31)
    selected = wsp.numeric.revision(anc31, itext(e31), p31)
    independent = wsp.numeric.revision(anc31, itext(e31), "")
    empty = wsp.numeric.revision(anc31, "", p31)
    chk("e31 selected recipe constructs", selected >= 1)
    chk("e31 independent recipe constructs", independent >= 1)
    chk("e31 empty selected recipe constructs", empty >= 1)
    chk("e31 selected and independent memberships equivalent", wsp.numeric.equivalent(selected, independent) == 1)
    snapshot = wsp.numeric.observe(selected)
    plain = wsp.numeric.observe(independent)
    chk("e31 selected observation is two", eqrat(snapshot, 0, 2, 1) == 1)
    chk("e31 selected observation has selection support", wsp.numeric.supporthas(snapshot, p31) == 1)
    chk("e31 selected observation has event support", wsp.numeric.supporthas(snapshot, q31) == 1)
    chk("e31 unconditional observation has no selection support", wsp.numeric.supporthas(plain, p31) == 0)
    chk("e31 unconditional observation retains event support", wsp.numeric.supporthas(plain, q31) == 1)
    derived = wsp.numeric.premiseover("wsconf4 e31 derived selector", snapshot)
    transitive = wsp.numeric.revision(anc31, itext(e31), derived)
    chk("e31 transitive selection recipe constructs", transitive >= 1)
    chk("e31 selection withdrawal commits", wsp.agent.withdraw(p31) == 1)
    chk("e31 selected query refuses withdrawn selection", wsp.numeric.livecount(selected) == -17)
    chk("e31 selected query refusal named withdrawn", streq(wsp.numeric.refusal(), "withdrawn") == 1)
    chk("e31 selected total refuses", wsp.numeric.total(selected) == -17)
    chk("e31 selected observation refuses", wsp.numeric.observe(selected) == -17)
    chk("e31 selected exclusion refuses", wsp.numeric.excluded(selected, e31) == -17)
    selectedreceipt = wsp.numeric.receipt(selected, e31)
    chk("e31 selected receipt is not fabricated", streq(selectedreceipt, "") == 1)
    chk("e31 selected receipt reports withdrawn selection", wsp.numeric.why() == -17)
    chk("e31 empty recipe still requires selection evidence", wsp.numeric.observe(empty) == -17)
    chk("e31 transitive selection observes withdrawn ancestor", wsp.numeric.observe(transitive) == -17)
    chk("e31 live selector assertion cannot hide withdrawn support", wsp.agent.premstate(derived) == 1)
    chk("e31 construction validates transitive selection support", wsp.numeric.revision(anc31, itext(e31), derived) == -17)
    chk("e31 current selection cannot use a withdrawn premise", wsp.numeric.revision(anc31, itext(e31), p31) == -17)
    chk("e31 historical snapshot preserves numeric payload", eqrat(snapshot, 0, 2, 1) == 1)
    chk("e31 historical snapshot retains withdrawn evidence", wsp.numeric.supporthas(snapshot, p31) == 1)
    chk("e31 historical snapshot is not current", wsp.numeric.usable(snapshot) == 0)
    chk("e31 independent event remains live", wsp.numeric.livecount(independent) == 1)
    chk("e31 independent event is not excluded", wsp.numeric.excluded(independent, e31) == 0)
    chk("e31 independent event has no withdrawal receipt", streq(wsp.numeric.receipt(independent, e31), "") == 1)
    chk("e31 independent recipe remains usable", eqrat(wsp.numeric.observe(independent), 0, 2, 1) == 1)
    fresh = wsp.numeric.revision(anc31, itext(e31), "")
    chk("e31 unrelated selection withdrawal permits a fresh independent recipe", fresh >= 1)
    chk("e31 fresh independent recipe retains the surviving event", eqrat(wsp.numeric.observe(fresh), 0, 2, 1) == 1)
    chk("e31 historical membership remains inspectable", wsp.numeric.members(selected) == 1)
    chk("e31 membership equivalence does not erase selection", wsp.numeric.equivalent(selected, independent) == 1)
    chk("e31 equivalent selected recipe still refuses", wsp.numeric.observe(selected) == -17)
    chk("e31 event withdrawal commits independently", wsp.agent.withdraw(q31) == 1)
    chk("e31 unconditional inventory excludes withdrawn event", wsp.numeric.livecount(independent) == 0)
    chk("e31 unconditional recipe reconstructs anchor", eqrat(wsp.numeric.observe(independent), 0, 0, 1) == 1)
    chk("e31 unconditional exclusion remains justified", wsp.numeric.excluded(independent, e31) == 1)
    chk("e31 unconditional receipt identifies event premise", streq(wsp.numeric.receipt(independent, e31), wsp.agent.premiseid(q31)) == 1)
    chk("e31 selected recipe cannot use event exclusion to erase control", wsp.numeric.excluded(selected, e31) == -17)
    retained = wsp.numeric.premiseover("wsconf4 retained inventory premise", anc31)
    target = wsp.numeric.event(anc31, dw31, retained)
    prefix = wsp.agent.store()
    later = wsp.numeric.premiseover("wsconf4 unresolved inventory premise", anc31)
    other = wsp.numeric.event(anc31, dw31, later)
    inventory = wsp.numeric.revision(anc31, evtext2(target, other), "")
    chk("query inventory initially resolves both events", wsp.numeric.livecount(inventory) == 2)
    wsp.agent.reset()
    chk("query prefix receiver loads", wsp.agent.load(prefix) == 1)
    chk("query target premise remains resolved", wsp.agent.premstate(retained) == 1)
    chk("query other candidate premise is unavailable", wsp.agent.premstate(later) == -1)
    chk("query retained target withdrawal commits", wsp.agent.withdraw(retained) == 1)
    chk("query retained target is known withdrawn", wsp.agent.premstate(retained) == 0)
    chk("query unknown other candidate blocks live set", wsp.numeric.livecount(inventory) == -12)
    chk("query unknown other candidate blocks target exclusion", wsp.numeric.excluded(inventory, target) == -12)
    partialreceipt = wsp.numeric.receipt(inventory, target)
    chk("query incomplete inventory cannot publish target receipt", streq(partialreceipt, "") == 1)
    chk("query incomplete inventory receipt reports unknown", wsp.numeric.why() == -12)
    known = wsp.numeric.premiseover("wsconf4 e31 unknown selector fixture", anc31)
    unresolved = wsp.numeric.revision(anc31, "", known)
    chk("e31 unknown selector fixture begins live", wsp.numeric.livecount(unresolved) == 0)
    ghost31 = compiler.digest.sha256("wsconf4 e31 never admitted selector")
    chk("e31 unresolved selection refuses construction", wsp.numeric.revision(anc31, "", ghost31) == -12)
    wsp.agent.reset()
    chk("e31 unavailable selector becomes unknown", wsp.agent.premstate(known) == -1)
    chk("e31 unknown selection blocks empty query", wsp.numeric.livecount(unresolved) == -12)
    chk("e31 unknown selection blocks total", wsp.numeric.total(unresolved) == -12)
    chk("e31 unknown selection blocks observation", wsp.numeric.observe(unresolved) == -12)
    chk("e31 unknown fixed inventory blocks exclusion", wsp.numeric.excluded(independent, e31) == -12)
    unknownreceipt = wsp.numeric.receipt(independent, e31)
    chk("e31 unknown inventory supplies no withdrawal receipt", streq(unknownreceipt, "") == 1)
    chk("e31 unknown inventory receipt reports unknown", wsp.numeric.why() == -12)

    line = "revision vector: "
    line = appv(line, itext(bc.ok))
    line = appv(line, " ok / ")
    line = appv(line, itext(bc.bad))
    line = appv(line, " FAIL")
    print(line)
    if bc.bad == 0
        print("PASS")
        return 0
    print("FAIL")
    1

os.exit(main())
